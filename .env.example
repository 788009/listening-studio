COSYVOICE_MODEL_DIR=voice/CosyVoice/pretrained_models/Fun-CosyVoice3-0.5B
LISTENING_ENVIRONMENT=development
LISTENING_DATABASE_URL=sqlite:///data/listening.db
LISTENING_DATA_DIR=data
LISTENING_LOG_DIR=logs
LISTENING_FRONTEND_DIST_DIR=frontend/dist
LISTENING_MAX_UPLOAD_BYTES=52428800
LISTENING_DIALOGUE_SILENCE_MILLISECONDS=500
LISTENING_DEBUG_AUTH_ENABLED=false
LISTENING_AUTH_SESSION_SECRET=development-only-change-before-use
LISTENING_AUTH_SESSION_COOKIE_NAME=listening_session
LISTENING_OIDC_ENABLED=false
LISTENING_OIDC_DISCOVERY_URL=https://issuer.example/.well-known/openid-configuration
LISTENING_OIDC_CLIENT_ID=replace-with-client-id
LISTENING_OIDC_CLIENT_SECRET=replace-with-client-secret
LISTENING_OIDC_REDIRECT_URI=http://127.0.0.1:18765/auth/oidc/callback
LISTENING_OIDC_POST_LOGIN_URL=http://127.0.0.1:5173/
LISTENING_OIDC_SCOPES=openid profile email phone
LISTENING_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
LISTENING_OIDC_PKCE_ENABLED=false
LISTENING_OIDC_FLOW_COOKIE_NAME=listening_oidc_flow
LISTENING_OIDC_FLOW_MAX_AGE_SECONDS=600
LISTENING_METRICS_TOKEN=replace-with-random-internal-token
LISTENING_LOG_ROTATION_BYTES=10485760
LISTENING_LOG_RETENTION_FILES=5
LISTENING_RATE_LIMIT_WINDOW_SECONDS=60
LISTENING_LOGIN_RATE_LIMIT=20
LISTENING_SEARCH_RATE_LIMIT=120
LISTENING_UPLOAD_RATE_LIMIT=20
LISTENING_GENERATION_RATE_LIMIT=60
LISTENING_PLAYBACK_RATE_LIMIT=600
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
DASHSCOPE_BASE_URL=https://example.cn/compatible-mode/v1
DASHSCOPE_MODEL=replace-with-dashscope-model
